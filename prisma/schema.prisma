generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id        String   @id @default("admin")
  email     String   @unique(map: "Admin_email_key") @default("admin@citypsychology.com")
  username  String   @default("Admin")
  password  String   @default("admin123")
  pin       String?  @default("1234")
  updatedAt DateTime
}

model homepagesection {
  id        String   @id
  enabled   Boolean  @default(true)
  data      String   @db.LongText
  updatedAt DateTime
}

model inbox {
  id            String   @id
  name          String
  email         String
  phone         String
  serviceType   String?  @default("Not specified")
  clientType    String?  @default("Not specified")
  sessionFormat String?  @default("Not specified")
  message       String?  @db.Text
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model media {
  id        String   @id
  name      String
  url       String   @db.Text
  size      Int      @default(0)
  mimeType  String   @default("image/png")
  altText   String?  @default("")
  title     String?  @default("")
  createdAt DateTime @default(now())
}

model page {
  id              String   @id
  title           String
  slug            String   @unique(map: "Page_slug_key")
  subtitle        String?  @default("")
  status          String   @default("active")
  showInNavbar    Boolean  @default(false)
  navOrder        Int      @default(0)
  showFooter      Boolean  @default(true)
  showContactCTA  Boolean  @default(true)
  featuredImage   String?  @db.Text
  imageAlt        String?  @default("")
  imageTitle      String?  @default("")
  contentHtml     String   @db.LongText
  customCss       String?  @db.LongText
  metaTitle       String?  @default("")
  metaDescription String?  @db.Text
  metaKeywords    String?  @default("")
  canonicalUrl    String?  @default("")
  ogTitle         String?  @default("")
  ogDescription   String?  @db.Text
  ogImage         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model setting {
  id        String   @id @default("default")
  general   String   @db.LongText
  socials   String   @db.LongText
  footer    String   @db.LongText
  seo       String   @db.LongText
  updatedAt DateTime
}
